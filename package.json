{
  "name": "boiler-route",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Weather-aware pedestrian routing for Purdue's West Lafayette campus",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "update-data": "node scripts/update-data.mjs",
    "heights": "uv run scripts/heights.py"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.4.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
